# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# LLM API - Get from https://platform.openai.com/api-keys
# You can also use any OpenAI-compatible API (Groq, Together, etc.)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Use Groq (free tier available) - https://console.groq.com
# GROQ_API_KEY=your_groq_api_key_here

# LLM Provider: "openai" or "groq"
LLM_PROVIDER=openai

# Model name
LLM_MODEL=gpt-3.5-turbo

# JWT Secret - change this to a long random string
SECRET_KEY=campus-ai-super-secret-key-change-this-in-production

# Token expiry in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=sqlite:///./data/campusai.db

# Upload folder
UPLOAD_DIR=./data/uploads

# Vector store folder
VECTOR_STORE_DIR=./data/vector_store

# CORS - frontend URL
FRONTEND_URL=http://localhost:5173
